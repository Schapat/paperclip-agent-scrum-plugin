{
  "name": "@schapat/paperclip-agent-scrum-plugin",
  "version": "2.0.12",
  "type": "module",
  "private": true,
  "description": "Autonomous Scrum team for Paperclip: state-driven ceremonies, a live Kanban board, and a team that learns from finished work.",
  "scripts": {
    "setup:sdk": "node ./scripts/link-sdk.mjs",
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "dev:ui": "paperclip-plugin-dev-server --root . --ui-dir dist/ui --port 4177",
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:coverage": "vitest run --coverage --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "scrum",
    "kanban",
    "agents",
    "automation"
  ],
  "author": "Schapat",
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "@paperclipai/shared": "file:.paperclip-sdk/paperclipai-shared-0.3.1.tgz"
    }
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "file:.paperclip-sdk/paperclipai-plugin-sdk-1.0.0.tgz",
    "@paperclipai/shared": "file:.paperclip-sdk/paperclipai-shared-0.3.1.tgz",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "@vitest/coverage-v8": "^3.0.5",
    "esbuild": "^0.27.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=22"
  }
}
